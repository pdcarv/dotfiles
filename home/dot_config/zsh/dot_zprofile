# Login shells (Ghostty and tmux start these). Runs after /etc/zprofile's
# path_helper, so the order set here sticks.
eval "$(/opt/homebrew/bin/brew shellenv)"

typeset -U path
path=(
    $HOME/bin
    $HOME/scripts
    $HOME/.local/bin
    $HOME/go/bin
    $HOME/.cargo/bin
    $path
)
path=($^path(N-/))

export GOPATH="$HOME/go"
export CLICOLOR=1

# Less
export LESS='-R --ignore-case --status-column --LONG-PROMPT --RAW-CONTROL-CHARS --HILITE-UNREAD --tabs=4 --no-init --window=-4'
export LESS_TERMCAP_mb=$'\E[1;31m'     # begin bold
export LESS_TERMCAP_md=$'\E[1;36m'     # begin blink
export LESS_TERMCAP_me=$'\E[0m'        # reset bold/blink
export LESS_TERMCAP_so=$'\E[01;44;33m' # begin reverse video
export LESS_TERMCAP_se=$'\E[0m'        # reset reverse video
export LESS_TERMCAP_us=$'\E[1;32m'     # begin underline
export LESS_TERMCAP_ue=$'\E[0m'        # reset underline

# Development
export PYTHONDONTWRITEBYTECODE=1        # Prevent Python from writing .pyc files
export VIRTUAL_ENV_DISABLE_PROMPT=1     # Let the prompt handle venv status
export DOCKER_BUILDKIT=1
export PODMAN_COMPOSE_PROVIDER=podman-compose
