" Minimal, plugin-free vim for remote boxes and quick edits; Neovim is the main editor.
set nocompatible encoding=utf-8
filetype plugin indent on
syntax on

set hidden number relativenumber ruler showcmd laststatus=2
set ignorecase smartcase incsearch hlsearch
set expandtab shiftwidth=4 softtabstop=4 autoindent
set backspace=indent,eol,start scrolloff=5 sidescrolloff=5
set wildmenu wildmode=longest:full,full
set mouse=a clipboard=unnamed noswapfile nobackup

" Persistent undo under $XDG_STATE_HOME
let s:undo = (empty($XDG_STATE_HOME) ? $HOME . '/.local/state' : $XDG_STATE_HOME) . '/vim/undo'
if !isdirectory(s:undo) | call mkdir(s:undo, 'p', 0700) | endif
let &undodir = s:undo
set undofile

set background=dark
silent! colorscheme retrobox

let mapleader = ' '
nnoremap <leader><space> :nohlsearch<CR>
